{
  "name": "thermosense",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "parazeeknova",
    "email": "dev.hashcodes@gmail.com"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev:web": "next dev",
    "build": "cross-env SKIP_ENV_VALIDATION=true next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start:web": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "electron": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently --kill-others \"npm run dev:web\" \"npm run build:electron && wait-on http-get://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:dist": "npm run build && npm run build:electron && electron-builder",
    "electron:dist:ci": "npm run build && npm run build:electron && electron-builder --config electron-builder-ci.json --publish=never",
    "electron:dist:all": "npm run build && npm run build:electron && electron-builder --mac --win --linux",
    "electron:dist:win": "npm run build && npm run build:electron && electron-builder --win",
    "electron:dist:mac": "npm run build && npm run build:electron && electron-builder --mac",
    "electron:dist:linux": "npm run build && npm run build:electron && electron-builder --linux",
    "electron:pack": "npm run build && npm run build:electron && electron-builder --dir",
    "clean": "rimraf dist release out .next",
    "clean:all": "npm run clean && rimraf node_modules package-lock.json",
    "postinstall": "electron-builder install-app-deps",
    "preelectron:pack": "npm run build && npm run build:electron",
    "release:patch": "npm version patch && git push --tags",
    "release:minor": "npm version minor && git push --tags",
    "release:major": "npm version major && git push --tags",
    "build:local": "node scripts/build-local.js",
    "build:local:all": "node scripts/build-local.js all",
    "build:local:clean": "node scripts/build-local.js --clean",
    "prepare:release": "node scripts/prepare-release.js",
    "prepare:release:minor": "node scripts/prepare-release.js minor",
    "prepare:release:major": "node scripts/prepare-release.js major",
    "setup:dev": "node scripts/setup-dev.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.83.0",
    "@trpc/client": "^11.4.3",
    "@trpc/next": "^11.4.3",
    "@trpc/react-query": "^11.4.3",
    "@trpc/server": "^11.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "15.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.1.0",
    "systeminformation": "^5.27.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.18.0",
    "@eslint-react/eslint-plugin": "^1.52.3",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/electron": "^1.4.38",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "eslint": "^9.31.0",
    "eslint-config-next": "15.4.2",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.thermosense.app",
    "productName": "ThermoSense",
    "copyright": "Copyright © 2025 ThermoSense",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "out/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/.cache",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "msi",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "build/icons/",
      "category": "Utility",
      "maintainer": "ThermoSense Team <contact@thermosense.app>",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        },
        {
          "target": "rpm",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ]
    },
    "deb": {
      "depends": ["gconf2", "gconf-service", "libnotify4", "libappindicator1", "libxtst6", "libnss3"],
      "maintainer": "ThermoSense Team <contact@thermosense.app>"
    },
    "rpm": {
      "depends": ["libnotify", "libappindicator"]
    }
  }
}
