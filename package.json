{
  "name": "thermosense",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev:web": "next dev",
    "build": "SKIP_ENV_VALIDATION=true next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start:web": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "electron": "npm run build:electron && NODE_ENV=development electron .",
    "electron:dev": "concurrently --kill-others \"npm run dev:web\" \"npm run build:electron && wait-on http-get://localhost:3000 && NODE_ENV=development electron .\"",
    "electron:dist": "npm run build && npm run build:electron && electron-builder",
    "preelectron:pack": "npm run build && npm run build:electron"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.83.0",
    "@trpc/client": "^11.4.3",
    "@trpc/next": "^11.4.3",
    "@trpc/react-query": "^11.4.3",
    "@trpc/server": "^11.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "15.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.1.0",
    "systeminformation": "^5.27.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.18.0",
    "@eslint-react/eslint-plugin": "^1.52.3",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/electron": "^1.4.38",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "eslint": "^9.31.0",
    "eslint-config-next": "15.4.2",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.thermosense.app",
    "productName": "ThermoSense",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
